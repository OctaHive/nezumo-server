# Copy this file to the repository root as .env.deploy and keep it private.
# Values may also be exported directly in the current shell.

DEPLOY_HOST=api.example.com
DEPLOY_USER=deploy
DEPLOY_PORT=22

# Preferred: use an absolute path to a dedicated private key.
DEPLOY_SSH_KEY="${HOME}/.ssh/nezumo_deploy"

# Alternative: comment out DEPLOY_SSH_KEY and set a password. Keep the actual
# .env.deploy file at mode 0600. SSH_ASKPASS prevents the password from
# appearing in command-line arguments.
# DEPLOY_PASSWORD=replace-me

DEPLOY_KNOWN_HOSTS="${HOME}/.ssh/known_hosts"

DEPLOY_PATH=/opt/nezumo
DEPLOY_SERVICES=nezumo.service
DEPLOY_BINARY_PATH=/opt/nezumo/bin/nezumo
DEPLOY_OWNER=nezumo
DEPLOY_GROUP=nezumo
DEPLOY_BINARY_MODE=0755
DEPLOY_MIGRATIONS=auto
# SQLx CLI is executed on the deployment machine, not on the server.
DEPLOY_SQLX_BIN=sqlx
# Required when DEPLOY_MIGRATIONS=auto. Keep the real value only in the ignored
# .env.deploy.
# DEPLOY_DATABASE_URL='postgres://user:password@db.example.com/database'

# Optional overrides:
# BUILD_PLATFORM=linux/amd64
# BUILD_OUTPUT_DIR=dist
# DEPLOY_ARCHIVE=/absolute/path/to/nezumo-0.1.0-x86_64-unknown-linux-gnu.tar.gz
# DEPLOY_RELEASE_NAME=manual-v0.1.0
